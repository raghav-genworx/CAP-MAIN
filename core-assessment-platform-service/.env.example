APP_NAME=Core Assessment Platform Service
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://cap_user:cap_password@localhost:55432/cap_core
AUTO_CREATE_RECRUITER_ROLE=true
REDIS_URL=redis://localhost:6379/0
CODE_EXECUTION_API_BASE_URL=http://localhost:8003/api/v1
CODE_EXECUTION_REQUEST_TIMEOUT_SECONDS=300
CODE_EVALUATION_API_BASE_URL=http://localhost:8004/api/v1
CODE_EVALUATION_REQUEST_TIMEOUT_SECONDS=30
INTERNAL_SERVICE_TOKEN=change-me-local-internal-service-token

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GPT_OSS_MODEL=openai/gpt-oss-120b
GROQ_RETRY_COUNT=3
GROQ_RETRY_BACKOFF_SECONDS=0.5
GROQ_REQUEST_TIMEOUT_SECONDS=60

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=CAP

BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CAP Assessments
BREVO_REQUEST_TIMEOUT_SECONDS=30

INVITE_TOKEN_PEPPER=change-me-local-invite-token-pepper
CANDIDATE_SESSION_SECRET=change-me-local-candidate-session-secret
CANDIDATE_SESSION_TTL_MINUTES=240
