APP_NAME=Code Evaluation Service
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
INTERNAL_SERVICE_TOKEN=change-me-local-internal-service-token
DATABASE_URL=postgresql+psycopg://cap_user:cap_password@localhost:55432/cap_core
EVALUATION_REPORT_DIR=data/reports
SEED_DEMO_EVALUATIONS=false
EVALUATION_WORKER_BATCH_SIZE=20
EVALUATION_WORKER_POLL_INTERVAL_SECONDS=5
EVALUATION_RETENTION_DAYS=365
EVALUATION_JOB_LEASE_SECONDS=300
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_RETRY_COUNT=3
GROQ_MAX_SOURCE_CHARS=80000
