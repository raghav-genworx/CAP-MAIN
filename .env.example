# Shared Docker Compose configuration
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=cap_core
POSTGRES_USER=cap_user
POSTGRES_PASSWORD=cap_password
POSTGRES_PORT=55432
JUDGE0_POSTGRES_DB=judge0

# Redis
REDIS_PASSWORD=cap_redis_password
REDIS_PORT=6380

# Published ports
FRONTEND_PORT=5173
API_GATEWAY_PORT=8001
CORE_SERVICE_PORT=8002
CODE_EXECUTION_PORT=8003
CODE_EVALUATION_PORT=8004
JUDGE0_PORT=12358

# Shared application configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
INTERNAL_SERVICE_TOKEN=change-me-local-internal-service-token

# AI gateway failover
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_GPT_OSS_MODEL=openai/gpt-oss-120b
GROQ_RETRY_COUNT=3
GROQ_RETRY_BACKOFF_SECONDS=0.5
GROQ_REQUEST_TIMEOUT_SECONDS=60

# Judge0 image and runtime
JUDGE0_REF=master
JUDGE0_SECRET_KEY_BASE=change-me-local-judge0-secret
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_MAX_CPU_TIME_LIMIT=15
JUDGE0_MEMORY_LIMIT=128000
JAVA_MINIMUM_MEMORY_LIMIT_KB=512000
JUDGE0_MAX_MEMORY_LIMIT=512000
JUDGE0_ENABLE_NETWORK=false

# Evaluation worker
SEED_DEMO_EVALUATIONS=false
EVALUATION_WORKER_BATCH_SIZE=20
EVALUATION_WORKER_POLL_INTERVAL_SECONDS=5
EVALUATION_RETENTION_DAYS=365
EVALUATION_JOB_LEASE_SECONDS=300
