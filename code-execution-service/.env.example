APP_NAME=Code Execution Service
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_REQUEST_TIMEOUT_SECONDS=10
JUDGE0_POLL_INTERVAL_SECONDS=0.5
JUDGE0_MAX_POLL_ATTEMPTS=30
DEFAULT_CPU_TIME_LIMIT_SECONDS=2
DEFAULT_MEMORY_LIMIT_KB=128000
INTERNAL_SERVICE_TOKEN=change-me-local-internal-service-token
