        "key": "startup-script",
        "value": "#!/usr/bin/env bash\nset -Eeuo pipefail\nexport DEBIAN_FRONTEND=noninteractive\nPROJECT_ID=\"gwx-internship-2026-01\"\nDATABASE_URL_SECRET=\"gwx-cap-database-url\"\nJUDGE0_LISTEN_PORT=\"8080\"\nNODE_VERSION=\"22.17.1\"\nIMAGE_TAG=\"cap-judge0-slim:js-patched\"\nBASE_TAG=\"cap-judge0-existing-base:latest\"\n\nput_status() {\n  local msg=\"$1\"\n  echo \"CAP_JUDGE0_STATUS=${msg}\"\n  curl -fsS -X PUT -H \"Metadata-Flavor: Google\" --data \"${msg}\" \"http://metadata.google.internal/computeMetadata/v1/instance/guest-attributes/cap-judge0/status\" >/dev/null 2>&1 || true\n}\ntrap 'put_status \"failed_line_${LINENO}\"' ERR\n\nput_status \"starting_node_only_patch\"\nmkdir -p /etc/default/grub.d\ncat > /etc/default/grub.d/99-judge0-cgroupv1.cfg <<'GRUBCFG'\nGRUB_CMDLINE_LINUX=\"$GRUB_CMDLINE_LINUX systemd.unified_cgroup_hierarchy=0 systemd.legacy_systemd_cgroup_controller=1\"\nGRUBCFG\nupdate-grub || true\nif ! grep -q \"systemd.unified_cgroup_hierarchy=0\" /proc/cmdline; then\n  put_status \"rebooting_for_cgroup_v1\"\n  shutdown -r now\n  exit 0\nfi\nput_status \"cgroup_v1_active\"\n\nput_status \"installing_tools\"\napt-get update\napt-get install -y --no-install-recommends docker.io curl ca-certificates jq python3\nsystemctl enable --now docker\n\nput_status \"waiting_for_existing_judge0\"\nfor i in $(seq 1 60); do\n  if docker inspect judge0-server >/dev/null 2>&1; then break; fi\n  sleep 2\ndone\nif ! docker inspect judge0-server >/dev/null 2>&1; then\n  put_status \"missing_existing_judge0_server\"\n  exit 1\nfi\n\nput_status \"reading_existing_env\"\nexisting_env=\"$(docker inspect judge0-server --format '{{range .Config.Env}}{{println .}}{{end}}')\"\nenv_val() { printf '%s\\n' \"${existing_env}\" | awk -F= -v k=\"$1\" '$1==k{print substr($0, length(k)+2); exit}'; }\nPOSTGRES_HOST=\"$(env_val POSTGRES_HOST)\"; POSTGRES_HOST=\"${POSTGRES_HOST:-35.227.59.162}\"\nPOSTGRES_PORT=\"$(env_val POSTGRES_PORT)\"; POSTGRES_PORT=\"${POSTGRES_PORT:-5432}\"\nPOSTGRES_DB=\"$(env_val POSTGRES_DB)\"; POSTGRES_DB=\"${POSTGRES_DB:-judge0}\"\nPOSTGRES_USER=\"$(env_val POSTGRES_USER)\"; POSTGRES_USER=\"${POSTGRES_USER:-raghavs}\"\nPOSTGRES_PASSWORD=\"$(env_val POSTGRES_PASSWORD)\"\nREDIS_HOST=\"$(env_val REDIS_HOST)\"; REDIS_HOST=\"${REDIS_HOST:-10.188.96.203}\"\nREDIS_PORT=\"$(env_val REDIS_PORT)\"; REDIS_PORT=\"${REDIS_PORT:-6379}\"\nREDIS_PASSWORD=\"$(env_val REDIS_PASSWORD)\"\nSECRET_KEY_BASE=\"$(env_val SECRET_KEY_BASE)\"; SECRET_KEY_BASE=\"${SECRET_KEY_BASE:-cap-gcp-judge0-secret-change-me}\"\n\nif [ -z \"${POSTGRES_PASSWORD}\" ]; then\n  put_status \"fetching_db_secret\"\n  ACCESS_TOKEN=\"$(curl -sf -H \"Metadata-Flavor: Google\" \"http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token\" | jq -r .access_token)\"\n  DATABASE_URL=\"$(curl -sf -H \"Authorization: Bearer ${ACCESS_TOKEN}\" \"https://secretmanager.googleapis.com/v1/projects/${PROJECT_ID}/secrets/${DATABASE_URL_SECRET}/versions/latest:access\" | jq -r .payload.data | base64 -d)\"\n  POSTGRES_PASSWORD=\"$(python3 -c 'import sys, urllib.parse; raw=sys.argv[1].replace(\"postgresql+psycopg\", \"postgresql\", 1); p=urllib.parse.urlparse(raw); print(urllib.parse.unquote(p.password or \"\"))' \"${DATABASE_URL}\")\"\nfi\nif [ -z \"${POSTGRES_PASSWORD}\" ]; then put_status \"missing_postgres_password\"; exit 1; fi\n\nput_status \"cleaning_failed_build_cache\"\ndocker builder prune -af || true\ndocker image prune -af || true\napt-get clean || true\nrm -rf /tmp/*\n\nput_status \"preparing_patch_context\"\nrm -rf /opt/cap-judge0-js-patch\nmkdir -p /opt/cap-judge0-js-patch\nprintf '%s' '' | base64 -d | tar -xzf - -C /opt/cap-judge0-js-patch\ncat > /opt/cap-judge0-js-patch/Dockerfile <<'DOCKERFILE'\n# syntax=docker/dockerfile:1\nARG BASE_IMAGE=cap-judge0-existing-base:latest\nFROM ${BASE_IMAGE}\nUSER root\nARG NODE_VERSION=22.17.1\nARG TARGETARCH\nENV NODE_VERSION=${NODE_VERSION}\nRUN set -eux; \\\n    apt-get update; \\\n    apt-get install -y --no-install-recommends ca-certificates curl xz-utils; \\\n    rm -rf /var/lib/apt/lists/*; \\\n    case \"${TARGETARCH:-amd64}\" in \\\n      amd64) node_arch=\"x64\" ;; \\\n      arm64) node_arch=\"arm64\" ;; \\\n      *) echo \"Unsupported Docker target architecture: ${TARGETARCH}\" >&2; exit 1 ;; \\\n    esac; \\\n    curl -fSL \"https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz\" -o /tmp/node.tar.xz; \\\n    tar -xJf /tmp/node.tar.xz -C /usr/local/bin --strip-components=2 \"node-v${NODE_VERSION}-linux-${node_arch}/bin/node\"; \\\n    chmod 0755 /usr/local/bin/node; \\\n    ln -sf /usr/local/bin/node /usr/bin/node; \\\n    test -x /usr/bin/node; \\\n    /usr/bin/node --version; \\\n    rm -f /tmp/node.tar.xz\nCOPY languages/active.rb /api/db/languages/active.rb\nCOPY languages/archived.rb /api/db/languages/archived.rb\nUSER judge0\nDOCKERFILE\n\nput_status \"tagging_existing_base\"\nBASE_IMAGE_ID=\"$(docker inspect judge0-server --format '{{.Image}}')\"\ndocker tag \"${BASE_IMAGE_ID}\" \"${BASE_TAG}\"\n\nput_status \"building_patch_image\"\ndocker build --platform=linux/amd64 --build-arg BASE_IMAGE=\"${BASE_TAG}\" --build-arg NODE_VERSION=\"${NODE_VERSION}\" -t \"${IMAGE_TAG}\" /opt/cap-judge0-js-patch\n\nput_status \"verifying_patch_image\"\ndocker run --rm --entrypoint /bin/sh \"${IMAGE_TAG}\" -lc '/usr/bin/node --version && grep -n \"JavaScript (Node.js)\" /api/db/languages/active.rb'\n\nput_status \"replacing_judge0_containers\"\ndocker rm -f judge0-server judge0-worker >/dev/null 2>&1 || true\nCOMMON_ENV=(\n  -e \"POSTGRES_HOST=${POSTGRES_HOST}\"\n  -e \"POSTGRES_PORT=${POSTGRES_PORT}\"\n  -e \"POSTGRES_DB=${POSTGRES_DB}\"\n  -e \"POSTGRES_USER=${POSTGRES_USER}\"\n  -e \"POSTGRES_PASSWORD=${POSTGRES_PASSWORD}\"\n  -e \"REDIS_HOST=${REDIS_HOST}\"\n  -e \"REDIS_PORT=${REDIS_PORT}\"\n  -e \"SECRET_KEY_BASE=${SECRET_KEY_BASE}\"\n  -e \"RAILS_ENV=production\"\n  -e \"RAILS_MAX_THREADS=2\"\n  -e \"RAILS_SERVER_PROCESSES=1\"\n  -e \"ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=true\"\n  -e \"ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=true\"\n)\nif [ -n \"${REDIS_PASSWORD}\" ]; then COMMON_ENV+=( -e \"REDIS_PASSWORD=${REDIS_PASSWORD}\" ); fi\n\ndocker run -d --name judge0-server --restart unless-stopped --privileged -p 0.0.0.0:${JUDGE0_LISTEN_PORT}:2358 \"${COMMON_ENV[@]}\" \"${IMAGE_TAG}\"\ndocker run -d --name judge0-worker --restart unless-stopped --privileged \"${COMMON_ENV[@]}\" \"${IMAGE_TAG}\" ./scripts/workers\n\nput_status \"waiting_for_readiness\"\nfor i in $(seq 1 120); do\n  if curl -fsS \"http://127.0.0.1:${JUDGE0_LISTEN_PORT}/languages\" | jq -e '.[] | select(.id == 63 and .name == \"JavaScript (Node.js)\")' >/dev/null && curl -fsS \"http://127.0.0.1:${JUDGE0_LISTEN_PORT}/workers\" >/dev/null; then\n    put_status \"ready\"\n    exit 0\n  fi\n  sleep 5\ndone\nput_status \"readiness_failed\"\ndocker ps -a || true\ndocker logs judge0-server || true\ndocker logs judge0-worker || true\nexit 1\n"
      }
    ],
